# Copy this file to .env at the vault root.
# Read directly by Templater/dataviewjs scripts (_HOME.md, templates/) via
# templater-utils.js's readRootEnv() — NOT by the Python scripts in
# _scripts/, which use _scripts/.env instead (see _scripts/.env.example).

# Local Ollama endpoint used for AI-assisted note generation
AI_URL=http://localhost:11434/api/generate
AI_MODEL=gpt-oss:120b-cloud

# Local transcription server (automation/transcribe_server.py), used by the
# conference "record session" button
TRANS_SERVER=http://localhost:11435

# Contact email sent with Crossref API requests for the "new papers" feed,
# per Crossref's polite-pool etiquette (https://api.crossref.org/) — the feed
# is skipped if this is unset
CROSSREF_MAILTO=you@example.com
