# Copy this file to _scripts/.env and fill in your values.
# Loaded by _scripts/utils/config.py at runtime.

# ── Required ─────────────────────────────────────────────────────────────
VAULT_ROOT=/absolute/path/to/your/vault
ZOTERO_DB=/absolute/path/to/zotero.sqlite

# ── Optional — AI providers (KPI classification, PDF/audio pipelines) ──────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# ── Optional — Zotero web API (beyond the local Zotero SQLite reads) ──────
ZOTERO_API_KEY=
ZOTERO_USER_ID=

# ── Optional — audio transcription ─────────────────────────────────────────
WHISPER_LANG=en

# ── Optional — misc integrations ───────────────────────────────────────────
ACTIVITYWATCH_URL=http://localhost:5600
SEMANTIC_SCHOLAR_API_KEY=
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=
HPC_USER=
HPC_HOST=
CORDIS=
