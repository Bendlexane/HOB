# ── Secrets / machine-local config ──────────────────────────────────────────
.env
_scripts/.env
# Shared secret the transcription server generates on first run.
_scripts/.transcribe_token

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
venv/
.venv/

# ── System ───────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── Node ─────────────────────────────────────────────────────────────────
node_modules/

# ── Obsidian ─────────────────────────────────────────────────────────────
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/
# Full Calendar CalDAV settings hold plaintext account passwords, so they never ship.
.obsidian/plugins/obsidian-full-calendar/data.json
# llm-wiki local embeddings cache (large, machine-specific)
.obsidian/plugins/llm-wiki/embeddings-cache.json
# Make.md rebuilds this folder on open; it holds a local index of every note.
# Ignored wholesale rather than file by file, so a new cache file Make.md
# starts writing does not silently become committed vault content.
.makemd/

# ── Generated by the vault as you use it ────────────────────────────────
# LLM Wiki rebuilds these from your own notes; they are output, not template.
wiki/knowledge.json
wiki/concepts/
wiki/entities/
wiki/sources/
# Your questions and the model's answers.
.obsidian/plugins/llm-wiki/interactions/
# Templater scratch file
00_STAGING/_tmp/

# ── PDFs — live in Zotero, not in the vault ─────────────────────────────
*.pdf
*.PDF

# ── LaTeX build artifacts ────────────────────────────────────────────────
*.aux
*.fls
*.fdb_latexmk
*.log
*.out
*.toc
*.synctex.gz
latex.out/

# ── R workspace ──────────────────────────────────────────────────────────
*.RData
*.rda
*.rds
.Rhistory
.RDataTmp

# ── Heavy/generated content this template doesn't ship with data for ────
06_PLANNING/kpis/research_kpis.db
06_PLANNING/kpis/research_kpis.db-wal
06_PLANNING/kpis/research_kpis.db-shm
06_PLANNING/kpis/exports/
_scripts/ml/posteriors.json
09_PEER_REVIEWS/**/manuscript/
09_PEER_REVIEWS/**/round_*/
04_PEOPLE/collaborators/_people-db.json.bak
